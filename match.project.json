{
  "name": "Doomsday-Match",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$attributes": {
        "DoomRole": "Match"
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "DoomLoader": {
        "$path": "src/first"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "DoomShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "DoomServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "DoomClient": {
          "$path": "src/client"
        }
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultTextChannels": true,
        "CreateDefaultCommands": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
